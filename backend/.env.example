# Server Port
PORT=4000

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?schema=public"

# Cryptographically Secure JWT Secret (min 32 characters in production)
# Generate with: openssl rand -base64 32
JWT_SECRET="<generate-random-base64-or-hex-secret-min-32-chars>"

# Token Lifespan
SESSION_TOKEN_EXPIRATION="4h"

# Optional: Initial Administrator Provisioning on Startup (omit if using 'npm run admin:create')
# BOOTSTRAP_ADMIN_EMAIL="<admin-email>"
# BOOTSTRAP_ADMIN_PASSWORD="<strong-password-min-8-chars>"
# BOOTSTRAP_ADMIN_ROLE="RESEARCHER"

